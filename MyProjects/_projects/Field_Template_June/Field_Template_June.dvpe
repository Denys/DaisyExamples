        "id": "main_knob_bank_1",
        "definitionId": "knob",
        "position": {
          "x": -1320,
          "y": -60
        },
        "parameterValues": {
          "bank": "MAIN",
          "touchGateThreshold": 0.012,
          "labels": [
            "Cutoff",
            "Reso",
            "Attack",
            "Decay",
            "Sustain",
            "Release",
            "Drive",
            "Color"
          ],
          "defaults": [
            0.58,
            0.12,
            0.02,
            0.22,
            0.78,
            0.24,
            0.12,
            0.5
          ]
        },
        "label": "K1-K8 MAIN BANK"
      },
      {
        "id": "alt_knob_bank_1",
        "definitionId": "knob",
        "position": {
          "x": -1320,
          "y": 80
        },
        "parameterValues": {
          "bank": "ALT",
          "touchGateThreshold": 0.012,
          "labels": [
            "EnvAmt",
            "LfoRt",
            "LfoDp",
            "Glide",
            "VelAmt",
            "KeyTrk",
            "Noise",
            "Sub"
          ],
          "defaults": [
            0.42,
            0.18,
            0.14,
            0.1,
            0.7,
            0.5,
            0,
            0.18
          ],
          "lfoRateRangeHz": [
            0.1,
            12
          ]
        },
        "label": "K1-K8 ALT BANK"
      },
      {
        "id": "sw1_bank_toggle_1",
        "definitionId": "switch",
        "position": {
          "x": -1280,
          "y": 220
        },
        "parameterValues": {
          "function": "toggle MAIN/ALT bank",
          "ledOnWhen": "ALT",
          "recordsNewTouchAnchors": true
        },
        "label": "SW1 BANK TOGGLE"
      },
      {
        "id": "sw2_bmode_toggle_1",
        "definitionId": "switch",
        "position": {
          "x": -1260,
          "y": 400
        },
        "parameterValues": {
          "function": "toggle B row CONTROLS/PERFORMANCE",
          "performanceNotes": [
            "C4",
            "D4",
            "E4",
            "F4",
            "G4",
            "A4",
            "B4",
            "C5"
          ],
          "heldModifier": "SW2 + K8 edits hidden output level"
        },
        "label": "SW2 B MODE"
      },
      {
        "id": "field_keybed_1",
        "definitionId": "keyboard_input",
        "position": {
          "x": -920,
          "y": 380
        },
        "parameterValues": {
          "physicalA": "wave select A1-A4, tri-state modes A5-A8",
          "physicalBControls": "transpose B1-B4, panic/reset B5-B8",
          "physicalBPerformance": "C4 D4 E4 F4 G4 A4 B4 C5",
          "scanRule": "A uses Keyboard indices 8-15, B uses 0-7"
        },
        "label": "FIELD KEYBED A/B"
      },
      {
        "id": "oled_display_1",
        "definitionId": "oled_display",
        "position": {
          "x": 620,
          "y": 120
        },
        "parameterValues": {
          "overviewHz": 20,
          "zoomDurationMs": 1400,
          "valueFormat": "integer Hz/ms/percent; LFO below 1 Hz uses mHz"
        },
        "label": "OLED OVERVIEW + ZOOM"
      },
      {
        "id": "key_leds_1",
        "definitionId": "led_array",
        "position": {
          "x": 620,
          "y": 320
        },
        "parameterValues": {
          "updateHz": 60,
          "defaultPolicy": "off unless active selection or active performance note",
          "a5ToA8Modes": "default off, next blink, second on"
        },
        "label": "KEY + KNOB LED FEEDBACK"
      },
