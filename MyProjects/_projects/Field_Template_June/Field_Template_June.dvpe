{
  "version": "1.0.0",
  "patch": {
    "metadata": {
      "name": "Field Template June",
      "author": "Codex / Daisy QAE",
      "description": "Controls-optimized Daisy Field mono template: MIDI note input, glide, oscillator plus sub plus noise, ADSR amplitude, SVF low-pass, soft drive, output trim, banked Field controls, OLED status, and key LED feedback.",
      "created": "2026-06-07T00:00:00Z",
      "modified": "2026-06-07T17:43:52.001Z",
      "version": "1.0.0",
      "targetHardware": "field",
      "sampleRate": 48000,
      "blockSize": 48
    },
    "blocks": [
      {
        "id": "midi_note_1",
        "definitionId": "midi_note",
        "position": {
          "x": -1280,
          "y": -240
        },
        "parameterValues": {
          "channel": "omni",
          "sustainCc": 64,
          "notePriority": "last"
        },
        "label": "MIDI NOTE + CC64"
      },
      {
        "id": "midi_to_freq_1",
        "definitionId": "midi_to_freq",
        "position": {
          "x": -1040,
          "y": -360
        },
        "parameterValues": {
          "transposeDefaultSemitones": 0,
          "transposeChoices": [
            -12,
            0,
            12,
            24
          ]
        },
        "label": "NOTE + TRANSPOSE TO Hz"
      },
      {
        "id": "glide_slew_1",
        "definitionId": "slew",
        "position": {
          "x": -800,
          "y": -240
        },
        "parameterValues": {
          "timeMinSeconds": 0,
          "timeMaxSeconds": 0.8,
          "modeDefault": "LEGATO"
        },
        "enabledCvPorts": [
          "time"
        ],
        "label": "GLIDE SLEW"
      },
      {
        "id": "osc_main_1",
        "definitionId": "oscillator",
        "position": {
          "x": -480,
          "y": -700
        },
        "parameterValues": {
          "waveformDefault": "WAVE_SAW",
          "waveformChoices": [
            "WAVE_SIN",
            "WAVE_TRI",
            "WAVE_SAW",
            "WAVE_SQUARE"
          ],
          "amp": 0.7,
          "pulseWidthMin": 0.08,
          "pulseWidthMax": 0.92
        },
        "enabledCvPorts": [
          "freq",
          "pw"
        ],
        "label": "MAIN OSC"
      },
      {
        "id": "osc_sub_1",
        "definitionId": "oscillator",
        "position": {
          "x": -480,
          "y": -280
        },
        "parameterValues": {
          "frequencyRatio": 0.5,
          "waveformDefault": "WAVE_SAW",
          "squareWhenMainSquare": true,
          "ampMax": 0.45
        },
        "enabledCvPorts": [
          "freq",
          "amp"
        ],
        "label": "SUB OSC"
      },
      {
        "id": "noise_1",
        "definitionId": "white_noise",
        "position": {
          "x": -320,
          "y": 320
        },
        "parameterValues": {
          "mixMin": 0,
          "mixMax": 0.3,
          "default": 0
        },
        "label": "NOISE SOURCE"
      },
      {
        "id": "source_mixer_1",
        "definitionId": "mixer",
        "position": {
          "x": 60,
          "y": -640
        },
        "parameterValues": {
          "inputs": 3,
          "mainColorGainMin": 0.6,
          "mainColorGainMax": 1
        },
        "label": "OSC + SUB + NOISE MIX"
      },
      {
        "id": "adsr_1",
        "definitionId": "adsr",
        "position": {
          "x": -460,
          "y": 420
        },
        "parameterValues": {
          "attackMinSeconds": 0.001,
          "attackMaxSeconds": 1.501,
          "decayMinSeconds": 0.001,
          "decayMaxSeconds": 2.001,
          "sustainDefault": 0.78,
          "releaseMinSeconds": 0.001,
          "releaseMaxSeconds": 2.501
        },
        "enabledCvPorts": [
          "attack",
          "decay",
          "sustain",
          "release"
        ],
        "label": "ADSR"
      },
      {
        "id": "amp_vca_1",
        "definitionId": "vca",
        "position": {
          "x": 60,
          "y": -180
        },
        "parameterValues": {
          "velocityModes": [
            "FIX",
            "SCL",
            "PCH"
          ]
        },
        "enabledCvPorts": [
          "gain"
        ],
        "label": "ENVELOPE + VELOCITY VCA"
      },
      {
        "id": "filter_svf_1",
        "definitionId": "svf",
        "position": {
          "x": 380,
          "y": -220
        },
        "parameterValues": {
          "mode": "lowpass",
          "cutoffMinHz": 50,
          "cutoffMaxHz": 12050,
          "resonanceMin": 0.15,
          "resonanceMax": 0.95,
          "envAmountMaxHz": 7000,
          "keyTrackMaxHz": 2500,
          "lfoDepthMaxHz": 3500,
          "runtimeClampMinHz": 40,
          "runtimeClampMaxHz": 18000
        },
        "enabledCvPorts": [
          "cutoff",
          "res"
        ],
        "label": "SVF LOWPASS"
      },
      {
        "id": "drive_1",
        "definitionId": "overdrive",
        "position": {
          "x": 380,
          "y": -440
        },
        "parameterValues": {
          "implementation": "tanh",
          "driveGainMin": 1,
          "driveGainMax": 8,
          "drive": null
        },
        "enabledCvPorts": [
          "drive"
        ],
        "label": "SOFT DRIVE"
      },
      {
        "id": "output_gain_1",
        "definitionId": "gain",
        "position": {
          "x": 600,
          "y": -400
        },
        "parameterValues": {
          "levelDefault": 0.8,
          "control": "SW2 + K8 hidden level"
        },
        "enabledCvPorts": [
          "level"
        ],
        "label": "OUTPUT LEVEL"
      },
      {
        "id": "audio_output_1",
        "definitionId": "audio_output",
        "position": {
          "x": 600,
          "y": -220
        },
        "parameterValues": {
          "channels": "dual mono"
        },
        "label": "AUDIO OUT L/R"
      },
      {
        "id": "lfo_1",
        "definitionId": "lfo",
        "position": {
          "x": -60,
          "y": 500
        },
        "parameterValues": {
          "waveform": "WAVE_SIN",
          "freqMinHz": 0.1,
          "freqMaxHz": 12,
          "displayBelow1Hz": "mHz",
          "amp": 1,
          "targetDefault": "FILT",
          "targetChoices": [
            "OFF",
            "PITCH",
            "FILT"
          ]
        },
        "enabledCvPorts": [
          "freq",
          "amp"
        ],
        "label": "LFO 0.1-12 Hz"
      },
      {
        "id": "lfo_pitch_depth_1",
        "definitionId": "vca",
        "position": {
          "x": 360,
          "y": 340
        },
        "parameterValues": {
          "pitchDepthMaxRatio": 0.03,
          "enabledWhen": "LFO target = PITCH"
        },
        "enabledCvPorts": [
          "gain"
        ],
        "label": "LFO PITCH DEPTH"
      },
      {
        "id": "lfo_filter_depth_1",
        "definitionId": "vca",
        "position": {
          "x": 340,
          "y": 560
        },
        "parameterValues": {
          "filterDepthMaxHz": 3500,
          "enabledWhen": "LFO target = FILT"
        },
        "enabledCvPorts": [
          "gain"
        ],
        "label": "LFO FILTER DEPTH"
      },
