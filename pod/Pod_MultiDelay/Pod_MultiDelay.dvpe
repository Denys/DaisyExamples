{
  "version": "1.0.0",
  "patch": {
    "metadata": {"name": "Pod MultiDelay", "version": "0.4.0", "targetHardware": "pod", "sampleRate": 48000, "blockSize": 48, "description": "DIST parameter page independent of enable; pre-delay drive feeds dry and delay. DIGI contract v1. Editor import not verified."},
    "hardwareConfig": {"platform": "pod", "peripherals": {"useSdram": true, "audioBlockSize": 48, "sampleRate": 48000}},
    "blocks": [
      {"id":"input", "definitionId":"audio_input", "position":{"x":0,"y":0}, "label":"L mono input; R ignored"},
      {"id":"drive", "definitionId":"custom_dsp", "position":{"x":150,"y":0}, "parameterValues":{"drive":[0,1],"tone":[0,1],"defaults":[0.4,0.5],"enabledDefault":false,"enableSource":"B1 edge on DIST page only","toggleRampSamples":240,"toneHz":[1000,12000],"oversampling":1}, "label":"Independent PRE distortion; clean path at OFF; also runs during delay pause/bypass"},
      {"id":"dsp", "definitionId":"custom_dsp", "position":{"x":300,"y":0}, "parameterValues":{"modes":["DIGI","TAPE","MOD","REV","FREEZE"],"digiConfigs":["SINGLE","SERIES","PARALLEL"],"slots":["TIME","FEEDBACK","MIX","COLOR","MOTION"],"digiRanges":{"timeMs":[20,2500],"feedback":[0,0.95],"mix":[0,1],"colorHz":"off then 20000..2000", "motion":"unassigned"},"digiDefaults":[400,0.35,0.35,6000,0],"dryGain":1,"d2RatioSteps":[0.25,0.33333333,0.375,0.5,0.66666667,0.75,1],"sourceParameterAuthority":"PedalDelayEngine descriptors for the other four modes", "historyFloats":240016,"freezeFloats":192016}, "label":"Two mono DIGI histories or referenced five-mode engine"},
      {"id":"controls", "definitionId":"pod_controls", "position":{"x":0,"y":200}, "parameterValues":{"encoder":"mode; click pages 1,2,3,DIST", "K1/K2":"TIME/FEEDBACK; MIX/COLOR; MOTION/unused; DRIVE/TONE", "B1":"DIST page: distortion on/off; other pages: delay bypass", "B2":"tap or capture; hold SHIFT", "shiftEncoder":"DIGI config or FREEZE state", "shiftClick":"trails", "shiftB1":"DIGI relink E2; FREEZE clear", "shiftPots":"DIGI D2 ratio/feedback except on DIST", "pickupThreshold":0.012,"menuChangesEnable":false}, "label":"Main-loop controls and coherent snapshot"},
      {"id":"transition", "definitionId":"custom_control", "position":{"x":300,"y":200}, "parameterValues":{"fadeSamples":240,"policy":"audio fade to dry, pause acknowledgement, main reconfigure, audio fade in"}},
      {"id":"output", "definitionId":"audio_output", "position":{"x":600,"y":0}, "label":"Same mono output on L and R"}
    ],
    "connections":[{"from":"input","to":"drive","type":"audio"},{"from":"drive","to":"dsp","type":"audio"},{"from":"dsp","to":"output","type":"audio"},{"from":"controls","to":"drive","type":"control"},{"from":"controls","to":"dsp","type":"control"},{"from":"controls","to":"transition","type":"control"},{"from":"transition","to":"dsp","type":"control"}]
  }
}
