nalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="DIG25" target="DIG21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="590"/><mxPoint x="210" y="590"/></Array></mxGeometry></mxCell><mxCell id="DIG34" value="&lt;b&gt;output gains (g1, g2)&lt;/b&gt;&lt;br&gt;SINGLE (1, 0)&lt;br&gt;SERIES (1, 1)&lt;br&gt;PARALLEL (0.5, 0.5)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="290" width="190" height="90" as="geometry"/></mxCell><mxCell id="DIG35" value="+" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="315" width="40" height="40" as="geometry"/></mxCell><mxCell id="DIG36" value="wet → mixer&lt;br&gt;y = x + MIX·wet" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="305" width="140" height="60" as="geometry"/></mxCell><mxCell id="DIG37" value="tap1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="DIG9" target="DIG34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="140"/><mxPoint x="900" y="320"/></Array></mxGeometry></mxCell><mxCell id="DIG38" value="tap2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="DIG26" target="DIG34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="490"/><mxPoint x="900" y="350"/></Array></mxGeometry></mxCell><mxCell id="DIG39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="DIG34" target="DIG35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="DIG40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="DIG35" target="DIG36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="DIG41" value="&lt;b&gt;DigiMap — contract §5-6 control law&lt;/b&gt; (once per block)&lt;br&gt;TIME slot → D1 = round(20 ms · 125&lt;sup&gt;t&lt;/sup&gt; · 48 kHz), 20 ms … 2.5 s&lt;br&gt;SHIFT+K1 → r ∈ {1/4, 1/3, 3/8, 1/2, 2/3, 3/4, 1}, default 3/4&lt;br&gt;FEEDBACK → k = 0.95·knob (E1 and E2 linked); SHIFT+K2 → k2 alone; SHIFT+B1 relinks&lt;br&gt;SERIES: f = 1 − √(1 − k)   ·   SINGLE / PARALLEL: f = k&lt;br&gt;COLOR → LP from 0.49·fs (off) down to 2 kHz, log; HP fixed 40 Hz&lt;br&gt;MOTION: unassigned in DIGI · config change: next block, histories never cleared" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="930" y="420" width="470" height="150" as="geometry"/></mxCell><mxCell id="DIG42" value="Each engine per sample: tap = h[D] (read before write) → cond = LP(HP(tap)) → h ← in + f·cond. In SINGLE, E2 keeps running with input 0 and decays, so switching back to a dual config keeps its tail. Checks: test_digi (contract §10 markers, §6 build-up, 18 × 60 s soaks), test_parity (1 440 000 samples bit-exact vs DigitalDelayNode)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="620" width="1250" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>