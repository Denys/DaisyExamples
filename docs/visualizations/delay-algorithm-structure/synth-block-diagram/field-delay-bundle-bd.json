  "metadata": {
    "summary": "Source-backed block diagram for the Daisy Field delay bundle. Blue cables are audio, green cables are controls/state writes, orange dashed cables are modulation-like DSP state, and gray dashed cables are UI/state feedback.",
    "trace": [
      {
        "id": "bundle-wrapper",
        "source": "MyProjects/_projects/Field_delay_bundle/Field_delay_bundle.cpp:1-5 includes the shared Field app and calls RunFieldDelayBundleProject."
      },
      {
        "id": "controls-report",
        "source": "MyProjects/_projects/Field_delay_bundle/CONTROLS.md:5-8 describes audio input, external MIDI, B-row notes, A1-A4 algorithm selection, A5/A6 synth modes, and A7/A8 octave shift."
      },
      {
        "id": "knob-layers",
        "source": "MyProjects/_projects/Field_delay_bundle/CONTROLS.md:42-68 lists movement-gated knob layers for Base, SW1, and SW2."
      },
      {
        "id": "field-runtime",
        "source": "MyProjects/_projects/Field_delay_shared/FieldDelayFieldApp.h:316-329 forwards the 48-sample audio callback to DaisyDelayFxCore::Process."
      },
      {
        "id": "field-controls",
        "source": "MyProjects/_projects/Field_delay_shared/FieldDelayFieldApp.h:332-365 writes moved knobs to the active layer parameters; lines 368-470 dispatch A/B keys."
      },
      {
        "id": "field-snapshots",
        "source": "MyProjects/_projects/Field_delay_shared/FieldDelayFieldApp.h:267-314 saves/restores per-algorithm parameter snapshots around source switching."
      },
      {
        "id": "field-io",
        "source": "MyProjects/_projects/Field_delay_shared/FieldDelayFieldApp.h:714-728 configures 48 kHz, 48-frame blocks, attaches SDRAM delay storage, primes controls, starts MIDI, and starts audio."
      },
      {
        "id": "core-api",
        "source": "DaisyHost/include/daisyhost/DaisyDelayFxCore.h:12-18 defines the four sources; lines 65-93 define the core and Process API; lines 215-235 define delay lines, voices, LFO, smoothing, damping, and tone state."
      },
      {
        "id": "core-process",
        "source": "DaisyHost/src/DaisyDelayFxCore.cpp:323-397 sums audio with internal synth, dispatches the selected algorithm, applies dry/wet, bypass, wet-only, gain, clamp, and writes stereo output."
      },
      {
        "id": "internal-synth",
        "source": "DaisyHost/src/DaisyDelayFxCore.cpp:710-746 handles MIDI note on/off; lines 970-1136 implement the 8-voice pluck/pad synth."
      },
      {
        "id": "algorithms",
        "source": "DaisyHost/src/DaisyDelayFxCore.cpp:1139-1337 implements MultiFX tape, Reverb tank, FunBox texture, and SDRAM long delay algorithms."
      }
    ]
  },
