+/** @file octavegenerator.h
+ *  @brief Sub-octave and octave-up generator for monophonic pedal inputs.
+ *  @ingroup pedal_pitch
+ */
+
+/*
+Copyright (c) 2026
+
+Use of this source code is governed by an MIT-style
+license that can be found in the LICENSE file or at
+https://opensource.org/licenses/MIT.
+*/
+
+#pragma once
+#ifndef DSY_PEDAL_OCTAVEGENERATOR_H
+#define DSY_PEDAL_OCTAVEGENERATOR_H
+
+#ifdef __cplusplus
+#include "Filters/onepole.h"
+#include "Utility/dcblock.h"
+
+namespace daisysp
+{
+/** Guitar-friendly octave generator that produces sub-octave and octave-up
+ *  voices from a monophonic input.
+ *
+ *  ## Example
+ *  ~~~~
+ *  OctaveGenerator octave;
+ *  octave.Init(48000.0f);
+ *  octave.SetSubGain(1.0f);
+ *  octave.SetUpGain(0.3f);
+ *  float wet = octave.Process(in);
+ *  ~~~~
+ *
+ *  @ingroup pedal_pitch
+ */
+class OctaveGenerator
+{
+  public:
+    OctaveGenerator() {}
+    ~OctaveGenerator() {}
+
+    /** Initialize the octave generator.
+     *  \param sample_rate Audio sample rate in Hz.
+     */
+    void Init(float sample_rate);
+
+    /** Process one sample and return the wet octave mix. */
+    float Process(float in);
+
+    /** Input drive before octave extraction. */
+    void SetDrive(float drive);
+
+    /** Tone shaping amount in the range 0..1. */
+    void SetTone(float tone);
+
+    /** Set the sub-octave blend. */
+    void SetSubGain(float gain) { sub_gain_ = gain; }
+
+    /** Set the octave-up blend. */
+    void SetUpGain(float gain) { up_gain_ = gain; }
+
+    /** Latest sub-octave voice. */
+    float GetSubOctave() const { return sub_octave_; }
+
+    /** Latest octave-up voice. */
+    float GetOctaveUp() const { return octave_up_; }
+
+  private:
+    void UpdateTone();
+
+    float   sample_rate_;
+    float   drive_;
+    float   tone_;
+    float   sub_gain_;
+    float   up_gain_;
+    float   sub_octave_;
+    float   octave_up_;
+    bool    last_positive_;
+    float   sub_polarity_;
+    OnePole tracker_;
+    OnePole sub_tone_;
+    OnePole up_tone_;
+    DcBlock sub_dc_;
+    DcBlock up_dc_;
+};
+} // namespace daisysp
+#endif
+#endif
diff --git a/Source/DaisyPedal/taptempo.cpp b/Source/DaisyPedal/taptempo.cpp
new file mode 100644
index 0000000..811f039
--- /dev/null
+++ b/Source/DaisyPedal/taptempo.cpp
@@ -0,0 +1,79 @@
+#include "taptempo.h"
+#include <algorithm>
+
+using namespace daisysp;
+
+void TapTempo::Init(float sample_rate, float default_bpm)
+{
+    sample_rate_     = sample_rate;
+    min_bpm_         = 30.0f;
+    max_bpm_         = 300.0f;
+    phase_           = 0.0f;
+    sample_counter_  = 0;
+    last_tap_sample_ = 0;
+    have_tap_        = false;
+    SetTempoBpm(default_bpm);
+}
+
+bool TapTempo::Process()
+{
+    ++sample_counter_;
+    phase_ += phase_inc_;
+    if(phase_ >= 1.0f)
+    {
+        phase_ -= 1.0f;
+        return true;
+    }
+    return false;
+}
+
+void TapTempo::TriggerTap()
+{
+    if(have_tap_)
+    {
+        const uint32_t delta = sample_counter_ - last_tap_sample_;
+        if(delta > 0)
+        {
+            const float tapped_bpm = (60.0f * sample_rate_) / static_cast<float>(delta);
+            if(tapped_bpm >= min_bpm_ && tapped_bpm <= max_bpm_)
+            {
+                SetTempoBpm(tapped_bpm);
+            }
+        }
+    }
+    last_tap_sample_ = sample_counter_;
+    have_tap_        = true;
+    ResetPhase();
+}
+
+void TapTempo::SetTempoBpm(float bpm)
+{
+    bpm_ = std::max(min_bpm_, std::min(max_bpm_, bpm));
+    UpdatePhaseIncrement();
+}
+
+void TapTempo::SetMinMaxBpm(float min_bpm, float max_bpm)
+{
+    min_bpm_ = min_bpm > 1.0f ? min_bpm : 1.0f;
+    max_bpm_ = max_bpm > min_bpm_ ? max_bpm : min_bpm_ + 1.0f;
+    SetTempoBpm(bpm_);
+}
+
+void TapTempo::ResetPhase(float phase)
+{
+    if(phase < 0.0f)
+        phase = 0.0f;
+    if(phase > 1.0f)
+        phase = 1.0f;
+    phase_ = phase;
+}
+
+uint32_t TapTempo::GetSamplesPerBeat() const
+{
+    return static_cast<uint32_t>(sample_rate_ / GetTempoHz());
+}
+
+void TapTempo::UpdatePhaseIncrement()
+{
+    phase_inc_ = GetTempoHz() / sample_rate_;
+}
