@@ -0,0 +1,98 @@
+/** @file noisegate.h
+ *  @brief Envelope-following gate for pedal signal chains.
+ *  @ingroup pedal_dynamics
+ */
+
+/*
+Copyright (c) 2026
+
+Use of this source code is governed by an MIT-style
+license that can be found in the LICENSE file or at
+https://opensource.org/licenses/MIT.
+*/
+
+#pragma once
+#ifndef DSY_PEDAL_NOISEGATE_H
+#define DSY_PEDAL_NOISEGATE_H
+
+#ifdef __cplusplus
+namespace daisysp
+{
+/** Simple envelope-following noise gate with hysteresis.
+ *
+ *  ## Parameters
+ *
+ *  - threshold: open threshold in linear amplitude
+ *  - hysteresis: close threshold offset below the open threshold
+ *  - attack: opening time in seconds
+ *  - release: closing time in seconds
+ *  - range: closed gain floor in linear amplitude
+ *
+ *  ## Example
+ *  ~~~~
+ *  NoiseGate gate;
+ *  gate.Init(48000.0f);
+ *  gate.SetThreshold(0.03f);
+ *  gate.SetRelease(0.08f);
+ *  float out = gate.Process(in);
+ *  ~~~~
+ *
+ *  @ingroup pedal_dynamics
+ */
+class NoiseGate
+{
+  public:
+    NoiseGate() {}
+    ~NoiseGate() {}
+
+    /** Initialize the noise gate.
+     *  \param sample_rate Audio sample rate in Hz.
+     */
+    void Init(float sample_rate);
+
+    /** Process a single audio sample through the gate. */
+    float Process(float in);
+
+    /** Set the open threshold in linear amplitude (0..1). */
+    void SetThreshold(float threshold);
+
+    /** Set the close hysteresis in linear amplitude (0..1). */
+    void SetHysteresis(float hysteresis);
+
+    /** Set how quickly the gate opens, in seconds. */
+    void SetAttack(float attack);
+
+    /** Set how quickly the gate closes, in seconds. */
+    void SetRelease(float release);
+
+    /** Set the closed gain range in linear amplitude (0..1). */
+    void SetRange(float range);
+
+    /** Returns the current detector envelope. */
+    float GetEnvelope() const { return envelope_; }
+
+    /** Returns the current gain reduction state. */
+    float GetGain() const { return gain_; }
+
+    /** Returns true while the gate is open. */
+    bool IsOpen() const { return is_open_; }
+
+  private:
+    void UpdateAttackCoeff();
+    void UpdateReleaseCoeff();
+
+    float sample_rate_;
+    float threshold_;
+    float hysteresis_;
+    float attack_;
+    float release_;
+    float range_;
+    float envelope_;
+    float gain_;
+    float attack_coeff_;
+    float release_coeff_;
+    bool  is_open_;
+};
+} // namespace daisysp
+#endif
+#endif
diff --git a/Source/DaisyPedal/octavegenerator.cpp b/Source/DaisyPedal/octavegenerator.cpp
new file mode 100644
index 0000000..b434f80
--- /dev/null
+++ b/Source/DaisyPedal/octavegenerator.cpp
@@ -0,0 +1,76 @@
+#include "octavegenerator.h"
+#include "Utility/dsp.h"
+#include <cmath>
+
+using namespace daisysp;
+
+void OctaveGenerator::Init(float sample_rate)
+{
+    sample_rate_    = sample_rate;
+    drive_          = 2.0f;
+    tone_           = 0.5f;
+    sub_gain_       = 1.0f;
+    up_gain_        = 0.0f;
+    sub_octave_     = 0.0f;
+    octave_up_      = 0.0f;
+    last_positive_  = true;
+    sub_polarity_   = 1.0f;
+
+    tracker_.Init();
+    tracker_.SetFilterMode(OnePole::FILTER_MODE_LOW_PASS);
+    tracker_.SetFrequency(600.0f / sample_rate_);
+
+    sub_tone_.Init();
+    sub_tone_.SetFilterMode(OnePole::FILTER_MODE_LOW_PASS);
+
+    up_tone_.Init();
+    up_tone_.SetFilterMode(OnePole::FILTER_MODE_LOW_PASS);
+
+    sub_dc_.Init(sample_rate_);
+    up_dc_.Init(sample_rate_);
+    UpdateTone();
+}
+
+float OctaveGenerator::Process(float in)
+{
+    const float driven = tanhf(drive_ * in);
+    const float track  = tracker_.Process(driven);
+    const bool  positive = track >= 0.0f;
+    if(!last_positive_ && positive)
+    {
+        sub_polarity_ = -sub_polarity_;
+    }
+    last_positive_ = positive;
+
+    const float amplitude = fabsf(track);
+    const float sub_raw   = amplitude * sub_polarity_;
+    const float up_raw    = (fabsf(driven) * 2.0f) - 1.0f;
+
+    sub_octave_ = sub_dc_.Process(sub_tone_.Process(sub_raw));
+    octave_up_  = up_dc_.Process(up_tone_.Process(up_raw));
+
+    return (sub_gain_ * sub_octave_) + (up_gain_ * octave_up_);
+}
+
+void OctaveGenerator::SetDrive(float drive)
+{
+    drive_ = drive > 0.0f ? drive : 0.0f;
+}
+
+void OctaveGenerator::SetTone(float tone)
+{
+    if(tone < 0.0f)
+        tone = 0.0f;
+    if(tone > 1.0f)
+        tone = 1.0f;
+    tone_ = tone;
+    UpdateTone();
+}
+
+void OctaveGenerator::UpdateTone()
+{
+    const float sub_cutoff = fclamp(120.0f + (tone_ * 1880.0f), 20.0f, sample_rate_ * 0.45f);
+    const float up_cutoff  = fclamp(300.0f + (tone_ * 7700.0f), 20.0f, sample_rate_ * 0.45f);
+    sub_tone_.SetFrequency(sub_cutoff / sample_rate_);
+    up_tone_.SetFrequency(up_cutoff / sample_rate_);
+}
