@@ -0,0 +1,85 @@
+/** @file bypassfader.h
+ *  @brief Smooth bypass-transition helper for pedal signal paths.
+ *  @ingroup pedal_control
+ */
+
+/*
+Copyright (c) 2026
+
+Use of this source code is governed by an MIT-style
+license that can be found in the LICENSE file or at
+https://opensource.org/licenses/MIT.
+*/
+
+#pragma once
+#ifndef DSY_PEDAL_BYPASSFADER_H
+#define DSY_PEDAL_BYPASSFADER_H
+
+#ifdef __cplusplus
+namespace daisysp
+{
+/** Smooth dry/wet crossfader that is useful for pedal bypass transitions.
+ *
+ *  ## Example
+ *  ~~~~
+ *  BypassFader fader;
+ *  fader.Init(48000.0f);
+ *  fader.SetFadeTime(0.02f);
+ *  fader.SetBypass(false);
+ *  float mixed = fader.Process(dry, wet);
+ *  ~~~~
+ *
+ *  @ingroup pedal_control
+ */
+class BypassFader
+{
+  public:
+    BypassFader() {}
+    ~BypassFader() {}
+
+    /** Initialize the bypass fader.
+     *  \param sample_rate Audio sample rate in Hz.
+     */
+    void Init(float sample_rate);
+
+    /** Crossfade between dry and wet signals.
+     *  \param dry Signal to pass while bypassed.
+     *  \param wet Signal to pass while active.
+     */
+    float Process(float dry, float wet);
+
+    /** Advance the fade state by one sample without mixing audio. */
+    void Advance();
+
+    /** Set the bypass state.
+     *  \param bypass True favors the dry signal, false favors the wet signal.
+     */
+    void SetBypass(bool bypass);
+
+    /** Set the fade time in seconds. */
+    void SetFadeTime(float fade_time);
+
+    /** Current wet mix position in the range 0..1. */
+    float GetFadePosition() const { return wet_mix_; }
+
+    /** Current dry mix position in the range 0..1. */
+    float GetDryMix() const { return 1.0f - wet_mix_; }
+
+    /** Returns true while the fader is moving toward its target. */
+    bool Transitioning() const;
+
+    /** Returns true when the dry path is the active target. */
+    bool Bypassed() const { return target_mix_ <= 0.0f; }
+
+  private:
+    void UpdateStep();
+
+    float sample_rate_;
+    float fade_time_;
+    float wet_mix_;
+    float target_mix_;
+    float step_;
+};
+} // namespace daisysp
+#endif
+#endif
diff --git a/Source/DaisyPedal/multirate.cpp b/Source/DaisyPedal/multirate.cpp
new file mode 100644
index 0000000..41d139b
--- /dev/null
+++ b/Source/DaisyPedal/multirate.cpp
@@ -0,0 +1,50 @@
+#include "multirate.h"
+
+using namespace daisysp;
+
+void Multirate::Init(float sample_rate, size_t ratio)
+{
+    sample_rate_  = sample_rate;
+    cutoff_hz_    = sample_rate * 0.25f;
+    filtered_     = 0.0f;
+    held_         = 0.0f;
+    phase_        = 0;
+    fresh_sample_ = false;
+    anti_alias_.Init();
+    anti_alias_.SetFilterMode(OnePole::FILTER_MODE_LOW_PASS);
+    SetRatio(ratio);
+    SetCutoff(cutoff_hz_);
+}
+
+float Multirate::Process(float in)
+{
+    filtered_     = anti_alias_.Process(in);
+    fresh_sample_ = false;
+
+    if(ratio_ <= 1)
+    {
+        held_         = filtered_;
+        fresh_sample_ = true;
+        return held_;
+    }
+
+    if(++phase_ >= ratio_)
+    {
+        phase_        = 0;
+        held_         = filtered_;
+        fresh_sample_ = true;
+    }
+    return held_;
+}
+
+void Multirate::SetRatio(size_t ratio)
+{
+    ratio_ = ratio > 0 ? ratio : 1;
+    phase_ = 0;
+}
+
+void Multirate::SetCutoff(float cutoff_hz)
+{
+    cutoff_hz_ = cutoff_hz > 1.0f ? cutoff_hz : 1.0f;
+    anti_alias_.SetFrequency(cutoff_hz_ / sample_rate_);
+}
diff --git a/Source/DaisyPedal/multirate.h b/Source/DaisyPedal/multirate.h
new file mode 100644
