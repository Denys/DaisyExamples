@@ -0,0 +1,85 @@
+/** @file multirate.h
+ *  @brief Lightweight low-rate conditioning helper for pedal DSP.
+ *  @ingroup pedal_pitch
+ */
+
+/*
+Copyright (c) 2026
+
+Use of this source code is governed by an MIT-style
+license that can be found in the LICENSE file or at
+https://opensource.org/licenses/MIT.
+*/
+
+#pragma once
+#ifndef DSY_PEDAL_MULTIRATE_H
+#define DSY_PEDAL_MULTIRATE_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+#include "Filters/onepole.h"
+
+namespace daisysp
+{
+/** Lightweight anti-aliased downsampler that returns a held low-rate signal at
+ *  the original audio rate.
+ *
+ *  ## Example
+ *  ~~~~
+ *  Multirate conditioner;
+ *  conditioner.Init(48000.0f, 4);
+ *  float held = conditioner.Process(in);
+ *  ~~~~
+ *
+ *  @ingroup pedal_pitch
+ */
+class Multirate
+{
+  public:
+    Multirate() {}
+    ~Multirate() {}
+
+    /** Initialize the multirate helper.
+     *  \param sample_rate Input sample rate in Hz.
+     *  \param ratio Downsample ratio, where 1 means full rate.
+     */
+    void Init(float sample_rate, size_t ratio = 2);
+
+    /** Process a sample and return the held low-rate value. */
+    float Process(float in);
+
+    /** Set the downsample ratio. */
+    void SetRatio(size_t ratio);
+
+    /** Set the anti-alias cutoff in Hz. */
+    void SetCutoff(float cutoff_hz);
+
+    /** Returns true if the last Process call captured a fresh low-rate sample. */
+    bool FreshSample() const { return fresh_sample_; }
+
+    /** The current low-rate held value. */
+    float LowRateValue() const { return held_; }
+
+    /** The current filtered full-rate value before hold/decimation. */
+    float FilteredValue() const { return filtered_; }
+
+    /** The current low-rate sample rate. */
+    float LowRateSampleRate() const { return sample_rate_ / static_cast<float>(ratio_); }
+
+    /** The current downsample ratio. */
+    size_t GetRatio() const { return ratio_; }
+
+  private:
+    OnePole anti_alias_;
+    float   sample_rate_;
+    float   cutoff_hz_;
+    float   filtered_;
+    float   held_;
+    size_t  ratio_;
+    size_t  phase_;
+    bool    fresh_sample_;
+};
+} // namespace daisysp
+#endif
+#endif
diff --git a/Source/DaisyPedal/noisegate.cpp b/Source/DaisyPedal/noisegate.cpp
new file mode 100644
index 0000000..83ba1d0
--- /dev/null
+++ b/Source/DaisyPedal/noisegate.cpp
@@ -0,0 +1,93 @@
+#include "noisegate.h"
+#include <algorithm>
+#include <cmath>
+
+using namespace daisysp;
+
+void NoiseGate::Init(float sample_rate)
+{
+    sample_rate_ = sample_rate;
+    threshold_   = 0.03f;
+    hysteresis_  = 0.01f;
+    attack_      = 0.002f;
+    release_     = 0.080f;
+    range_       = 0.0f;
+    envelope_    = 0.0f;
+    gain_        = 0.0f;
+    is_open_     = false;
+    UpdateAttackCoeff();
+    UpdateReleaseCoeff();
+}
+
+float NoiseGate::Process(float in)
+{
+    const float detector = fabsf(in);
+    const float env_coeff
+        = detector > envelope_ ? attack_coeff_ : release_coeff_;
+    envelope_ += env_coeff * (detector - envelope_);
+
+    const float close_threshold
+        = std::max(0.0f, threshold_ - hysteresis_);
+
+    if(is_open_)
+    {
+        if(envelope_ < close_threshold)
+            is_open_ = false;
+    }
+    else if(envelope_ >= threshold_)
+    {
+        is_open_ = true;
+    }
+
+    const float target_gain = is_open_ ? 1.0f : range_;
+    const float gain_coeff  = is_open_ ? attack_coeff_ : release_coeff_;
+    gain_ += gain_coeff * (target_gain - gain_);
+    return in * gain_;
+}
+
+void NoiseGate::SetThreshold(float threshold)
+{
+    threshold_ = std::max(0.0f, std::min(1.0f, threshold));
+}
+
+void NoiseGate::SetHysteresis(float hysteresis)
+{
+    hysteresis_ = std::max(0.0f, std::min(1.0f, hysteresis));
+}
+
+void NoiseGate::SetAttack(float attack)
+{
+    attack_ = attack > 0.0f ? attack : 0.0f;
+    UpdateAttackCoeff();
+}
+
+void NoiseGate::SetRelease(float release)
+{
+    release_ = release > 0.0f ? release : 0.0f;
+    UpdateReleaseCoeff();
+}
+
+void NoiseGate::SetRange(float range)
+{
+    range_ = std::max(0.0f, std::min(1.0f, range));
+}
+
+void NoiseGate::UpdateAttackCoeff()
+{
+    if(attack_ <= 0.0f || sample_rate_ <= 0.0f)
+    {
+        attack_coeff_ = 1.0f;
+        return;
+    }
+    attack_coeff_ = 1.0f - expf(-1.0f / (attack_ * sample_rate_));
+}
+
+void NoiseGate::UpdateReleaseCoeff()
+{
+    if(release_ <= 0.0f || sample_rate_ <= 0.0f)
+    {
+        release_coeff_ = 1.0f;
+        return;
+    }
+    release_coeff_ = 1.0f - expf(-1.0f / (release_ * sample_rate_));
+}
diff --git a/Source/DaisyPedal/noisegate.h b/Source/DaisyPedal/noisegate.h
new file mode 100644
